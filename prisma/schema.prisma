generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  income
  expense
}

enum PaymentMethodType {
  cash
  debit
  credit
  pix
  transfer
  other
}

enum TransactionType {
  income
  expense
}

model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  type      CategoryType
  color     String?
  icon      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  parentId  String?      @map("parent_id") @db.Uuid
  active    Boolean      @default(true)

  parent        Category?     @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subcategories Category[]    @relation("CategoryToSubcategory")
  transactions  Transaction[]

  @@index([parentId])
  @@map("categories")
}

model PaymentMethod {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  type        PaymentMethodType
  description String?
  active      Boolean           @default(true)

  transactions Transaction[]

  @@map("payments_methods")
}

model Transaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            TransactionType
  title           String
  amount          Decimal         @db.Decimal(12, 2)
  categoryId      String?         @map("category_id") @db.Uuid
  paymentMethod   String?         @map("payment_method")
  occurredAt      DateTime        @default(dbgenerated("CURRENT_DATE")) @map("occurred_at") @db.Date
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentMethodId String?         @map("payment_method_id") @db.Uuid

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment  PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([paymentMethodId])
  @@map("transactions")
}
