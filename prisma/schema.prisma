generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  type          CategoryType
  color         String?
  icon          String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  parentId      String?       @map("parent_id") @db.Uuid
  spaceId       String?       @map("space_id") @db.Uuid
  active        Boolean       @default(true)
  parent        Category?     @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subcategories Category[]    @relation("CategoryToSubcategory")
  transactions  Transaction[] @relation("TransactionCategory")
  subcategoryTransactions Transaction[] @relation("TransactionSubcategory")
  space         Space?        @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parentId])
  @@index([spaceId])
  @@map("categories")
}

model PaymentMethod {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         PaymentMethodType
  description  String?
  active       Boolean           @default(true)
  spaceId      String?           @map("space_id") @db.Uuid
  space        Space?            @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions Transaction[]

  @@index([spaceId])
  @@map("payments_methods")
}

model Transaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            TransactionType
  title           String
  amount          Decimal         @db.Decimal(12, 2)
  categoryId      String?         @map("category_id") @db.Uuid
  paymentMethod   String?         @map("payment_method")
  occurredAt      DateTime        @default(dbgenerated("CURRENT_DATE")) @map("occurred_at") @db.Date
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentMethodId String?         @map("payment_method_id") @db.Uuid
  subcategoryId   String?         @map("subcategory_id") @db.Uuid
  spaceId         String?         @map("space_id") @db.Uuid
  category        Category?       @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategory     Category?       @relation("TransactionSubcategory", fields: [subcategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment         PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  space           Space?          @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([paymentMethodId])
  @@index([subcategoryId])
  @@index([spaceId])
  @@map("transactions")
}

model Space {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  ownerId        String          @default(dbgenerated("auth.uid()")) @map("owner_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  categories     Category[]
  paymentMethods PaymentMethod[]
  transactions   Transaction[]
  members        SpaceMember[]

  @@index([ownerId])
  @@map("spaces")
}

model SpaceMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  userId      String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  role        String   @default("member")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

enum CategoryType {
  income
  expense
}

enum PaymentMethodType {
  cash
  debit
  credit
  pix
  transfer
  other
}

enum TransactionType {
  income
  expense
}
